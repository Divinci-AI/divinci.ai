{
  "name": "divinci-ai-site",
  "compatibility_date": "2025-01-15",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public/",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Run worker first for HTML pages (URL rewriting on preview/dev URLs) AND
    // for API endpoints. Without /api/*, Cloudflare's static asset handler
    // intercepts POSTs and returns 405 before the worker can answer.
    // Static assets (CSS, JS, images) are still served directly for performance.
    "run_worker_first": ["/", "/*/", "/*/*/", "/*/*/*/", "/*/*/*/*/", "/*.html", "/api/*",
      // Agent-readiness discovery documents. Most are extensionless, so the
      // static handler would serve them as application/octet-stream; the
      // specs require application/linkset+json / application/json. The
      // worker returns null for paths it does not own, so
      // /.well-known/security.txt and the agent-skills SKILL.md files
      // still fall through to ASSETS.
      // /robots.txt: there was ALSO a static/robots.txt, which shadowed the
      // worker's handler completely — the handler had been dead code, and the
      // served file hardcoded divinci.ai's sitemap even on staging. The static
      // file is deleted; this line makes the worker the single source.
      "/robots.txt",
      "/.well-known/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_NAME": "Divinci AI",
    "CACHE_VERSION": "v1",
    "BASE_URL": "https://divinci.ai"
  },
  "routes": [
    { "pattern": "divinci.ai/*", "zone_name": "divinci.ai" },
    { "pattern": "www.divinci.ai/*", "zone_name": "divinci.ai" }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],

  // Rolling 90-day uptime history for /status. Written opportunistically on
  // /api/status cache-misses (the footer indicator generates steady traffic),
  // so no cron trigger is required — see handleStatus() in src/worker.js.
  // ── Customer-facing edge-error collector ────────────────────────────
  //
  // Every 5 minutes, ask Cloudflare how many 5xx hit CUSTOMER hosts and paths
  // and publish the answer to Datadog (see src/customer-health.mjs). This one
  // is a cron rather than request-driven like the history sampler, because it
  // feeds the PAGER: a signal that goes blind whenever the marketing site is
  // quiet at 4am is worse than no signal.
  //
  // ⚠️ dev and staging deploy this same code and MUST NOT run it — two
  // environments submitting the same metric double every value the monitor
  // reads. Their `triggers.crons` are explicitly emptied below (named
  // environments otherwise inherit this block), and scheduled() also refuses
  // unless ENVIRONMENT is production.
  //
  // ⚠️ CONSEQUENCE, since 2026-08-26: the lower environments' /status pages
  // are INERT, and this is expected rather than broken. The cron is now the
  // only writer of both the customer-facing rating and the uptime history, so
  // with no cron staging shows Platform: unknown, `configured: false`, and a
  // history that never grows. Do not "fix" that by giving staging a cron —
  // its other collector would then double-submit the metric a pager reads,
  // which is the failure this block exists to prevent. Verify status-page
  // changes against a local build with /api/status stubbed instead; that is
  // what tests/status-attribution.spec.js does.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "kv_namespaces": [
    {
      "binding": "STATUS_HISTORY",
      "id": "4d3eb9e275804f3090b9c0f96154381d"
    }
  ],
  "workers_dev": false,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node scripts/check-universe-freshness.mjs && python3 scripts/build-open-web-vectors-data.py && python3 scripts/build-assistant-pages.py && python3 scripts/build-search-index.py && python3 scripts/build-agent-skills.py && python3 scripts/build-llms-full.py && zola build && node scripts/build-headers.mjs"
  },
  "limits": {
    "cpu_ms": 50
  },

  // ── Lower environments ──────────────────────────────────────────────
  "env": {
    "dev": {
      "name": "divinci-ai-site-dev",
      // Never run the collector outside production — see triggers above.
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "development",
        "SITE_NAME": "Divinci AI (Dev)",
        "CACHE_VERSION": "v1",
        "BASE_URL": "https://dev.divinci.ai"
      },
      "routes": [
        { "pattern": "dev.divinci.ai/*", "zone_name": "divinci.ai" }
      ],
      "workers_dev": false,
      "build": {
        "command": "node scripts/check-universe-freshness.mjs && python3 scripts/build-open-web-vectors-data.py && python3 scripts/build-assistant-pages.py && python3 scripts/build-search-index.py && python3 scripts/build-agent-skills.py && python3 scripts/build-llms-full.py && zola build --base-url https://dev.divinci.ai && node scripts/build-headers.mjs --env dev"
      }
    },
    "staging": {
      "name": "divinci-ai-site-staging",
      // Never run the collector outside production — see triggers above.
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_NAME": "Divinci AI (Staging)",
        "CACHE_VERSION": "v1",
        "BASE_URL": "https://staging.divinci.ai"
      },
      "routes": [
        { "pattern": "staging.divinci.ai/*", "zone_name": "divinci.ai" }
      ],
      // Separate namespace so staging samples never pollute the public
      // production uptime history.
      "kv_namespaces": [
        {
          "binding": "STATUS_HISTORY",
          "id": "7fcc432e9d2e46fea6d6cf0c6f11f7cb"
        }
      ],
      "workers_dev": false,
      "build": {
        "command": "node scripts/check-universe-freshness.mjs && python3 scripts/build-open-web-vectors-data.py && python3 scripts/build-assistant-pages.py && python3 scripts/build-search-index.py && python3 scripts/build-agent-skills.py && python3 scripts/build-llms-full.py && zola build --base-url https://staging.divinci.ai && node scripts/build-headers.mjs --env staging"
      }
    }
  }
}
