# Cloudflare Worker secrets for divinci.ai site (contact form + optional KV).
# Set via: wrangler secret put <NAME> --env staging|production
# Never commit real values to git.

# Turnstile secret for /api/contact (pairs with public sitekey in templates)
TURNSTILE_SECRET_KEY=

# Optional: KV namespace binding for contact-form rate limits (configured in wrangler.jsonc)
