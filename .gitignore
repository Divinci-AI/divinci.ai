node_modules
.DS_Store

# Large video files (stored in Cloudflare R2)
*.mp4
*.webm
*.mov
*.avi

# Wrangler state directory with R2 blobs
.wrangler/
**/.wrangler/

# Build artifacts
site/public/

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Generated by site/scripts/build-assistant-pages.py at build time — build
# output, not source. Committing one would pin a snapshot of an assistant's
# answers that the next build overwrites (or, worse, that no longer matches
# what the assistant says).
site/content/a/*.md
!site/content/a/_index.md

# Python bytecode from the build-time generators and their tests.
__pycache__/
*.pyc
